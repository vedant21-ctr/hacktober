# DecisionVault Environment Configuration

# Server
PORT=4000
DB_PATH=./decisionvault.db

# LLM Runtime (live, record, replay)
# Only gemma4:e4b via local Ollama is supported
LLM_MODE=replay
OLLAMA_BASE_URL=http://localhost:11434

# Optional GitHub Token for Ingestion (server-side only, never sent to client)
GITHUB_TOKEN=

# Frontend Configuration
# Set to 'mock' to show the MOCK DATA banner during contract development
NEXT_PUBLIC_API_MODE=

