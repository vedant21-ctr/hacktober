{
  "name": "decisionvault",
  "version": "0.1.0",
  "private": true,
  "description": "Open Source Decision Intelligence and Knowledge Recovery",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "apps/web",
    "tests"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"server,web\" -c \"blue.bold,green.bold\" \"npm run dev --workspace=@decisionvault/server\" \"npm run dev --workspace=@decisionvault/web\"",
    "build": "npm run build --workspace=@decisionvault/shared && npm run build --workspace=@decisionvault/server && npm run build --workspace=@decisionvault/web",
    "typecheck": "npm run build --workspace=@decisionvault/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace=@decisionvault/tests",
    "test:coverage": "npm run test:coverage --workspace=@decisionvault/tests",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
